{
  "keepDefaultCss": true,
  "sidebarClosedBelow": 1100,
  "settings": {
    "baseTone": {
      "type": "class",
      "ui": "tone-cards",
      "label": "Base tone",
      "options": [
        {
          "value": "tone-graphite",
          "label": "Graphite (warm)",
          "default": true
        },
        {
          "value": "tone-slate",
          "label": "Slate (cool)"
        },
        {
          "value": "tone-midnight",
          "label": "Midnight"
        }
      ]
    },
    "accentColor": {
      "type": "color",
      "ui": "accent-presets",
      "var": "--primary",
      "default": "#589284",
      "label": "Accent colour",
      "presets": [
        { "name": "Sage", "value": "#589284" },
        { "name": "Steel", "value": "#5b82a6" },
        { "name": "Ochre", "value": "#b89356" },
        { "name": "Terracotta", "value": "#b86f5c" },
        { "name": "Iris", "value": "#8673a8" },
        { "name": "Moss", "value": "#6d9658" }
      ],
      "derive": [
        {
          "type": "contrast",
          "foreground": true,
          "options": ["#f4f6f8", "#141618"],
          "var": "--text-primary"
        },
        {
          "type": "lightness",
          "delta": 0.42,
          "satScale": 0.92,
          "var": "--accent-lighter"
        },
        {
          "type": "lightness",
          "delta": 0.22,
          "satScale": 0.96,
          "var": "--accent-light"
        },
        {
          "type": "lightness",
          "delta": -0.18,
          "var": "--accent-dark"
        },
        {
          "type": "lightness",
          "delta": -0.35,
          "satScale": 1.02,
          "var": "--accent-darker"
        },
        {
          "type": "opacity",
          "opacity": 0.15,
          "var": "--primary-hover"
        },
        {
          "type": "opacity",
          "opacity": 0.15,
          "var": "--accent-subtle"
        },
        {
          "type": "opacity",
          "opacity": 0.24,
          "var": "--accent-muted"
        },
        {
          "type": "opacity",
          "opacity": 0.4,
          "var": "--accent-border"
        }
      ]
    },
    "logoUrl": {
      "type": "text",
      "label": "Logo URL",
      "hint": "Optional. Shown instead of the panel name in the top bar. A light logo on a transparent background (~28px high) works best.",
      "default": ""
    },
    "listType": {
      "type": "class",
      "tkey": "common.theme.ListType",
      "options": [
        {
          "value": "list-type-grid",
          "label": "Large cards (2 per row)",
          "default": true
        },
        {
          "value": "list-type-list",
          "tkey": "common.theme.listType.List"
        }
      ]
    },
    "fontSize": {
      "type": "snippet",
      "tkey": "common.theme.FontSize",
      "options": [
        {
          "value": ":root{font-size: calc(100% + 4px)}",
          "label": "+2"
        },
        {
          "value": ":root{font-size: calc(100% + 2px)}",
          "label": "+1"
        },
        {
          "value": ":root{font-size: 100%}",
          "tkey": "common.theme.fontSize.Default",
          "default": true
        },
        {
          "value": ":root{font-size: calc(100% - 2px)}",
          "label": "-1"
        }
      ]
    },
    "fontFace": {
      "type": "snippet",
      "tkey": "common.theme.FontFace",
      "options": [
        {
          "value": "",
          "tkey": "common.theme.fontFace.Default",
          "default": true
        },
        {
          "value": "body{--standard-font:'Atkinson Hyperlegible Next', sans-serif;--headline-font:'Atkinson Hyperlegible Next', sans-serif;--monospace-font:'Atkinson Hyperlegible Mono', monospace}",
          "tkey": "common.theme.fontFace.A11y"
        }
      ]
    }
  }
}
